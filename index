  { char: "o", ipa: "/o/" },
  { char: "u", ipa: "/u/" }
];

const ALPHABET_NASAL = [
  { char: "ã", ipa: "/ã/" },
  { char: "ẽ", ipa: "/ẽ/" },
  { char: "ĩ", ipa: "/ĩ/" },
  { char: "õ", ipa: "/õ/" },
  { char: "ũ", ipa: "/ũ/" }
];

function renderLetterCards(targetId, items, extraClass = "") {
  document.getElementById(targetId).innerHTML = items.map(item =>
    `<div class="letter-card ${extraClass}">
      <div class="letter-char">${item.char}</div>
      <div class="letter-ipa">${item.ipa}</div>
    </div>`
  ).join("");
}

renderLetterCards("alphaConsonants", ALPHABET_CONSONANTS);
renderLetterCards("alphaOralVowels", ALPHABET_ORAL, "vowel");
renderLetterCards("alphaNasalVowels", ALPHABET_NASAL, "nasal");

/* =========================================================
   DICTIONARY
   ========================================================= */

const dictBody = document.getElementById("dictBody");
const dictSearch = document.getElementById("dictSearch");
const searchClear = document.getElementById("searchClear");
const dictCount = document.getElementById("dictCount");
const posFiltersEl = document.getElementById("posFilters");
const sortBtn = document.getElementById("sortBtn");

let activePos = "all";
let sortAsc = true;

function escapeHTML(s) {
  return String(s).replace(/[&<>"']/g, ch => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  }[ch]));
}

// Build POS filter buttons dynamically from VOCAB
const posCounts = VOCAB.reduce((acc, item) => {
  acc[item.pos] = (acc[item.pos] || 0) + 1;
  return acc;
}, {});

const sortedPos = Object.keys(posCounts).sort((a, b) => posCounts[b] - posCounts[a]);

posFiltersEl.innerHTML = [
  `<button class="filter-pill active" data-pos="all">All (${VOCAB.length})</button>`,
  ...sortedPos.map(pos =>
    `<button class="filter-pill" data-pos="${escapeHTML(pos)}">${escapeHTML(pos)} (${posCounts[pos]})</button>`
  )
].join("");

posFiltersEl.addEventListener("click", e => {
  const btn = e.target.closest("[data-pos]");
  if (!btn) return;
  activePos = btn.dataset.pos;
  posFiltersEl.querySelectorAll(".filter-pill").forEach(b => b.classList.toggle("active", b === btn));
  renderDictionary();
});

sortBtn.addEventListener("click", () => {
  sortAsc = !sortAsc;
  sortBtn.textContent = sortAsc ? "Sort: A → Z" : "Sort: Z → A";
  renderDictionary();
});

function renderDictionary() {
  const rawQuery = dictSearch.value.trim();
  const q = stripDiacritics(rawQuery);
  searchClear.classList.toggle("visible", rawQuery.length > 0);

  let rows = VOCAB.filter(v => {
    const matchesPos = activePos === "all" || v.pos === activePos;
    const matchesQuery = !q || v.searchBlob.includes(q);
    return matchesPos && matchesQuery;
  });

  if (!sortAsc) {
    rows = [...rows].reverse();
  }

  if (rows.length === 0) {
    dictBody.innerHTML = `<tr><td colspan="3" class="empty-state">No dictionary entries match <strong>“${escapeHTML(rawQuery)}”</strong>${activePos !== "all" ? ` in <em>${escapeHTML(activePos)}</em>` : ""}.</td></tr>`;
  } else {
    dictBody.innerHTML = rows.map(v =>
      `<tr>
        <td class="lemma">${escapeHTML(v.lemma)}</td>
        <td>${escapeHTML(v.gloss)}</td>
        <td><span class="pos-badge" data-pos="${escapeHTML(v.pos)}">${escapeHTML(v.pos)}</span></td>
      </tr>`
    ).join("");
  }

  dictCount.textContent = `${rows.length} of ${VOCAB.length} lemmas`;
}

dictSearch.addEventListener("input", renderDictionary);
searchClear.addEventListener("click", () => {
  dictSearch.value = "";
  dictSearch.focus();
  renderDictionary();
});
renderDictionary();

/* =========================================================
   GRAMMAR SUFFIX FILTERS & EXAMPLE FILTERS
   ========================================================= */

document.getElementById("suffixFilters").addEventListener("click", e => {
  const btn = e.target.closest("[data-suffix-filter]");
  if (!btn) return;
  const val = btn.dataset.suffixFilter;
  document.querySelectorAll("#suffixFilters .filter-pill").forEach(b => b.classList.toggle("active", b === btn));
  document.querySelectorAll(".suffix-group").forEach(g => {
    g.classList.toggle("hidden", val !== "all" && g.dataset.suffixGroup !== val);
  });
});

document.getElementById("exampleFilters").addEventListener("click", e => {
  const btn = e.target.closest("[data-ex-filter]");
  if (!btn) return;
  const val = btn.dataset.exFilter;
  document.querySelectorAll("#exampleFilters .filter-pill").forEach(b => b.classList.toggle("active", b === btn));
  document.querySelectorAll(".example-group").forEach(g => {
    g.classList.toggle("hidden", val !== "all" && g.dataset.exGroup !== val);
  });
});

/* =========================================================
   NAVIGATION & HASH ROUTING
   ========================================================= */

const VALID_PAGES = new Set(["overview", "mission", "alphabet", "phonology", "grammar", "dictionary", "examples"]);

function showPage(id, updateHash = true) {
  if (!VALID_PAGES.has(id)) id = "overview";
  document.querySelectorAll(".page").forEach(p => p.classList.toggle("active", p.id === id));
  document.querySelectorAll(".tab").forEach(t => t.classList.toggle("active", t.dataset.page === id));
  if (updateHash && location.hash !== `#${id}`) {
    history.replaceState(null, "", `#${id}`);
  }
  window.scrollTo({ top: 0, behavior: "smooth" });
}

document.querySelectorAll(".tab").forEach(tab => {
  tab.addEventListener("click", () => showPage(tab.dataset.page));
});

document.querySelectorAll("[data-goto]").forEach(el => {
  el.addEventListener("click", () => showPage(el.dataset.goto));
});

// Load initial page from URL hash if present
const initialHash = location.hash.replace("#", "");
if (VALID_PAGES.has(initialHash)) {
  showPage(initialHash, false);
}

window.addEventListener("hashchange", () => {
  const h = location.hash.replace("#", "");
  if (VALID_PAGES.has(h)) showPage(h, false);
});
</script>
</body>
