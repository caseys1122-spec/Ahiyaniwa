<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Ahiyaniwa Taíno — Language Revitalization</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --deep: #092624;
    --deep-2: #124542;
    --sea: #196e66;
    --turquoise: #25a697;
    --turquoise-soft: rgba(37, 166, 151, 0.11);
    --bg: #f8f5ef;
    --bg-subtle: #f1ece2;
    --surface: #ffffff;
    --coral: #d95d39;
    --coral-soft: rgba(217, 93, 57, 0.10);
    --gold: #c6953b;
    --gold-soft: rgba(198, 149, 59, 0.14);
    --ink: #162625;
    --ink-2: #3a4d4b;
    --muted: #627472;
    --line: rgba(9, 38, 36, 0.09);
    --line-strong: rgba(9, 38, 36, 0.16);
    --shadow-sm: 0 2px 10px rgba(9, 38, 36, 0.04);
    --shadow-md: 0 10px 32px rgba(9, 38, 36, 0.07);
    --shadow-lg: 0 20px 56px rgba(9, 38, 36, 0.12);
    --radius-sm: 10px;
    --radius: 16px;
    --radius-lg: 24px;
    --font-serif: "Cormorant Garamond", Georgia, serif;
    --font-sans: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    background:
      radial-gradient(ellipse 60% 40% at 8% 0%, rgba(37, 166, 151, 0.09), transparent 65%),
      radial-gradient(ellipse 50% 35% at 92% 4%, rgba(217, 93, 57, 0.06), transparent 60%),
      var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.68;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--sea);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  a:hover { color: var(--turquoise); }

  h1, h2, h3, h4 {
    font-family: var(--font-serif);
    letter-spacing: -0.005em;
    margin: 0;
    font-weight: 700;
    color: var(--deep);
  }
  h1 { font-size: clamp(3rem, 6.2vw, 5rem); line-height: 0.96; }
  h2 { font-size: clamp(2rem, 3.4vw, 2.9rem); line-height: 1.08; }
  h3 { font-size: 1.55rem; line-height: 1.2; color: var(--deep-2); }
  h4 { font-size: 1.2rem; line-height: 1.25; color: var(--deep-2); }

  p {
    margin: 0.65rem 0;
    color: var(--ink-2);
    font-size: 0.975rem;
    line-height: 1.72;
  }
  p strong { color: var(--ink); font-weight: 600; }
  em { color: var(--deep); }

  .small { font-size: 0.875rem; color: var(--muted); }
  .mono { font-family: var(--font-mono); }

  .shell {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  /* =========================================
     STICKY TOPBAR NAVIGATION
     ========================================= */
  header.topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 245, 239, 0.84);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
    padding: 10px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    text-align: left;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--deep) 0%, var(--sea) 100%);
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(9, 38, 36, 0.22);
    border: 1px solid rgba(198, 149, 59, 0.35);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--deep);
    letter-spacing: 0.01em;
  }
  .brand-sub {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  nav.tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px;
    background: rgba(9, 38, 36, 0.045);
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  nav.tabs::-webkit-scrollbar { display: none; }

  .tab {
    border: 0;
    background: transparent;
    color: var(--ink-2);
    padding: 8px 15px;
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.84rem;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .tab:hover {
    color: var(--deep);
    background: rgba(255, 255, 255, 0.65);
  }
  .tab.active {
    background: var(--deep);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(9, 38, 36, 0.2);
  }

  /* =========================================
     MAIN & PAGE TRANSITIONS
     ========================================= */
  main {
    flex: 1;
    padding: 36px 0 88px;
  }

  .page {
    display: none;
    animation: pageIn 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .page.active { display: block; }

  @keyframes pageIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* =========================================
     HERO CARD (OVERVIEW)
     ========================================= */
  .hero-banner {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    padding: clamp(36px, 6vw, 68px) clamp(28px, 5vw, 60px);
    background:
      radial-gradient(circle at 12% 18%, rgba(37, 166, 151, 0.34), transparent 44%),
      radial-gradient(circle at 88% 12%, rgba(198, 149, 59, 0.24), transparent 38%),
      radial-gradient(circle at 75% 95%, rgba(217, 93, 57, 0.16), transparent 40%),
      linear-gradient(135deg, #061b1a 0%, #0a2d2b 52%, #134a45 100%);
    color: #ffffff;
    box-shadow: var(--shadow-lg);
    margin-bottom: 28px;
  }

  .hero-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.4), transparent 85%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 13px;
    border-radius: 999px;
    background: rgba(37, 166, 151, 0.18);
    color: #7ee8db;
    border: 1px solid rgba(126, 232, 219, 0.25);
  }
  .hero-badge.gold {
    background: rgba(198, 149, 59, 0.16);
    color: #f0cf85;
    border-color: rgba(240, 207, 133, 0.3);
  }

  .hero-banner h1 {
    color: #ffffff;
    margin-bottom: 14px;
    font-weight: 600;
  }

  .hero-lead {
    font-size: 1.12rem;
    line-height: 1.65;
    color: #d2e4e1;
    max-width: 620px;
    margin: 0;
  }
  .hero-lead strong { color: #ffffff; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .btn {
    border: 0;
    cursor: pointer;
    border-radius: 999px;
    padding: 12px 22px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .btn-primary {
    background: linear-gradient(135deg, #d8aa4e, #c6953b);
    color: #08201e;
    box-shadow: 0 8px 22px rgba(198, 149, 59, 0.32);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    box-shadow: 0 12px 26px rgba(198, 149, 59, 0.42);
  }
  .btn-ghost {
    background: rgba(255, 255, 255, 0.09);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-1px);
  }
  .btn-soft {
    background: var(--turquoise-soft);
    color: var(--deep-2);
    border: 1px solid rgba(37, 166, 151, 0.22);
    padding: 9px 16px;
    font-size: 0.82rem;
  }
  .btn-soft:hover {
    background: rgba(37, 166, 151, 0.18);
  }

  /* Quick Stat Strip */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 40px;
  }
  .stat-tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .stat-tile:hover {
    border-color: rgba(37, 166, 151, 0.35);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .stat-value {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--deep);
    line-height: 1.05;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 500;
    margin-top: 4px;
  }

  /* =========================================
     PAGE HEADERS & PILLS
     ========================================= */
  .section-head {
    margin-bottom: 32px;
    max-width: 780px;
  }
  .section-head h2 { margin-top: 10px; }
  .section-head p {
    font-size: 1.04rem;
    color: var(--ink-2);
    margin-top: 10px;
  }

  .sub-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin: 44px 0 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .sub-section-head:first-of-type { margin-top: 24px; }
  .sub-section-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--turquoise-soft);
    color: var(--deep-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pill.coral { background: var(--coral-soft); color: #9c381c; }
  .pill.gold { background: var(--gold-soft); color: #7a5512; }
  .pill.neutral { background: rgba(9, 38, 36, 0.06); color: var(--muted); }

  /* =========================================
     GRIDS & CARDS
     ========================================= */
  .grid { display: grid; gap: 20px; }
  .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }
  .card.accent { border-top: 4px solid var(--turquoise); }
  .card.coral { border-top: 4px solid var(--coral); }
  .card.gold { border-top: 4px solid var(--gold); }
  .card h3 { margin-bottom: 8px; }

  .orthography {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .orthography span {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--deep);
  }

  .note {
    border-left: 4px solid var(--gold);
    background: linear-gradient(90deg, rgba(198, 149, 59, 0.10), rgba(198, 149, 59, 0.03));
    border-top: 1px solid rgba(198, 149, 59, 0.18);
    border-right: 1px solid rgba(198, 149, 59, 0.12);
    border-bottom: 1px solid rgba(198, 149, 59, 0.12);
    padding: 20px 24px;
    border-radius: 0 var(--radius) var(--radius) 0;
    color: #4d3e1e;
    margin: 28px 0 0;
    font-size: 0.96rem;
    line-height: 1.7;
  }
  .note strong { color: #362a10; }

  /* =========================================
     ALPHABET
     ========================================= */
  .alpha-group { margin-bottom: 28px; }
  .alpha-group:last-of-type { margin-bottom: 0; }
  .alpha-group-title {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .alphabet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(86px, 1fr));
    gap: 12px;
  }

  .letter-card {
    background: linear-gradient(160deg, #0d3633 0%, #071e1c 100%);
    border-radius: 14px;
    padding: 18px 10px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(9, 38, 36, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .letter-card:hover {
    transform: translateY(-3px);
    border-color: rgba(37, 166, 151, 0.55);
  }
  .letter-card.vowel {
    background: linear-gradient(160deg, #164f49 0%, #0c312e 100%);
  }
  .letter-card.nasal {
    background: linear-gradient(160deg, #3c2f17 0%, #241b0c 100%);
    border-color: rgba(198, 149, 59, 0.24);
  }
  .letter-char {
    font-family: var(--font-serif);
    font-size: 2.35rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 8px;
  }
  .letter-ipa {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: #7ee8db;
    background: rgba(37, 166, 151, 0.18);
    padding: 3px 9px;
    border-radius: 999px;
  }
  .letter-card.nasal .letter-ipa {
    color: #f0cf85;
    background: rgba(198, 149, 59, 0.2);
  }

  /* =========================================
     TABLES & PHONOLOGY CHARTS
     ========================================= */
  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin: 14px 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    background: var(--deep);
    color: #ffffff;
    padding: 12px 15px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  td {
    padding: 12px 15px;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    color: var(--ink);
    vertical-align: middle;
  }

  tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: rgba(37, 166, 151, 0.035); }

  .ipa-table th {
    background: var(--bg-subtle);
    color: var(--deep);
    border-bottom: 1px solid var(--line-strong);
  }
  .ipa-table td, .ipa-table th {
    text-align: center;
    padding: 11px 10px;
  }
  .ipa-table td:first-child, .ipa-table th:first-child {
    text-align: left;
    font-weight: 600;
    color: var(--deep-2);
    padding-left: 14px;
    background: rgba(248, 245, 239, 0.55);
  }
  .ipa-pair {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
  }
  .ipa-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
  }
  .ipa-item .sym {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--deep);
  }
  .ipa-item .val {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .ipa-empty { color: rgba(9, 38, 36, 0.18); font-size: 0.85rem; }

  /* =========================================
     GRAMMAR SUB-NAV & CARDS
     ========================================= */
  .jump-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .jump-link {
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-2);
    padding: 6px 13px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    transition: all 0.2s ease;
  }
  .jump-link:hover {
    background: var(--turquoise-soft);
    color: var(--deep);
    border-color: rgba(37, 166, 151, 0.3);
  }

  .grammar-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }
  .grammar-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .grammar-num {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--turquoise-soft);
    color: var(--deep-2);
    font-size: 0.78rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .grammar-card h3 { margin: 0; font-size: 1.45rem; }

  .deep-dive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 18px 0 12px;
  }
  .deep-dive-box {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 20px;
  }
  .deep-dive-box h4 {
    color: var(--deep);
    margin-bottom: 6px;
  }

  /* Filter Pills */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .filter-pill {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-2);
    padding: 7px 14px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .filter-pill:hover {
    border-color: var(--turquoise);
    color: var(--deep);
  }
  .filter-pill.active {
    background: var(--deep);
    color: #ffffff;
    border-color: var(--deep);
  }

  /* Suffix Cards */
  .suffix-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 24px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .suffix-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }
  .suffix-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .suffix-form {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--deep);
    background: var(--turquoise-soft);
    padding: 2px 14px;
    border-radius: 8px;
    line-height: 1.25;
  }
  .suffix-card[data-cat="verb"] .suffix-form {
    background: var(--coral-soft);
    color: #8f3217;
  }
  .suffix-card[data-cat="postposition"] .suffix-form {
    background: var(--gold-soft);
    color: #704d0e;
  }
  .suffix-type {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--muted);
  }
